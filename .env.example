# Copy to .env and fill in. NEVER commit .env.
# Token from @BotFather (t.me/BotFather -> /newbot)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Everything below has sensible defaults; override only if you need to.
TZ=Asia/Singapore
DB_PATH=/data/fambot.db
MEMBERS_FILE=/app/members.json
LOG_LEVEL=INFO

# Seconds between scans of the durable jobs table.
TICK_SECONDS=30
